{
 "auth": {
  "bearer": [
   {
    "key": "token",
    "value": "{{farmer_token}}"
   }
  ],
  "type": "bearer"
 },
 "info": {
  "description": "FARMMARKET \u2014 Bangladesh farmer & buyer marketplace (FastAPI + MySQL/SQLAlchemy, JWT auth). Import into Postman, set base_url, then run the Auth folder first: the login requests save farmer_token / buyer_token to collection variables. Demo accounts (after `python seed_demo.py`): farmer@farmmarket.demo / buyer@farmmarket.demo, password Demo123!. Prices/forecasts are demo data unless real price history is ingested; see README.md.",
  "name": "FARMMARKET",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "item": [
  {
   "item": [
    {
     "name": "Health check",
     "request": {
      "method": "GET",
      "url": "{{base_url}}/api/health"
     }
    }
   ],
   "name": "Health"
  },
  {
   "item": [
    {
     "name": "Register farmer (dev: saves verification_token)",
     "request": {
      "body": {
       "mode": "raw",
       "raw": "{\n  \"name\": \"Rahim Uddin\",\n  \"email\": \"farmer@farmmarket.demo\",\n  \"password\": \"Demo123!\",\n  \"role\": \"farmer\",\n  \"district\": \"Gazipur\",\n  \"upazila\": \"Sreepur\",\n  \"phone\": \"01700000000\"\n}"
      },
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "method": "POST",
      "url": "{{base_url}}/api/v1/auth/register"
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "var j = pm.response.json();",
         "if (j.verification_token) pm.collectionVariables.set('verification_token', j.verification_token);"
        ],
        "type": "text/javascript"
       }
      }
     ]
    },
    {
     "name": "Register buyer",
     "request": {
      "body": {
       "mode": "raw",
       "raw": "{\n  \"name\": \"Ayesha Khan\",\n  \"email\": \"buyer@farmmarket.demo\",\n  \"password\": \"Demo123!\",\n  \"role\": \"buyer\",\n  \"district\": \"Gazipur\",\n  \"phone\": \"01800000000\"\n}"
      },
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "method": "POST",
      "url": "{{base_url}}/api/v1/auth/register"
     }
    },
    {
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "var j = pm.response.json();",
         "if (j.access_token) pm.collectionVariables.set('farmer_token', j.access_token);",
         "if (j.refresh_token) pm.collectionVariables.set('farmer_refresh_token', j.refresh_token);"
        ],
        "type": "text/javascript"
       }
      }
     ],
     "name": "Login farmer (saves farmer_token)",
     "request": {
      "body": {
       "mode": "raw",
       "raw": "{\n  \"email\": \"farmer@farmmarket.demo\",\n  \"password\": \"Demo123!\"\n}"
      },
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "method": "POST",
      "url": "{{base_url}}/api/v1/auth/login"
     }
    },
    {
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "var j = pm.response.json();",
         "if (j.access_token) pm.collectionVariables.set('buyer_token', j.access_token);",
         "if (j.refresh_token) pm.collectionVariables.set('buyer_refresh_token', j.refresh_token);"
        ],
        "type": "text/javascript"
       }
      }
     ],
     "name": "Login buyer (saves buyer_token)",
     "request": {
      "body": {
       "mode": "raw",
       "raw": "{\n  \"email\": \"buyer@farmmarket.demo\",\n  \"password\": \"Demo123!\"\n}"
      },
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "method": "POST",
      "url": "{{base_url}}/api/v1/auth/login"
     }
    },
    {
     "name": "Me (farmer token)",
     "request": {
      "auth": {
       "bearer": [
        {
         "key": "token",
         "value": "{{farmer_token}}"
        }
       ],
       "type": "bearer"
      },
      "method": "GET",
      "url": "{{base_url}}/api/v1/auth/me"
     }
    },
    {
     "name": "Login transporter (saves transporter_token)",
     "request": {
      "method": "POST",
      "url": "{{base_url}}/api/v1/auth/login",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"email\": \"transporter@farmmarket.demo\",\n  \"password\": \"Demo123!\"\n}"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "var j = pm.response.json();",
         "if (j.access_token) pm.collectionVariables.set('transporter_token', j.access_token);",
         "if (j.refresh_token) pm.collectionVariables.set('transporter_refresh_token', j.refresh_token);"
        ],
        "type": "text/javascript"
       }
      }
     ]
    },
    {
     "name": "Login admin (saves admin_token)",
     "request": {
      "method": "POST",
      "url": "{{base_url}}/api/v1/auth/login",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"email\": \"admin@farmmarket.demo\",\n  \"password\": \"Demo123!\"\n}"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "var j = pm.response.json();",
         "if (j.access_token) pm.collectionVariables.set('admin_token', j.access_token);",
         "if (j.refresh_token) pm.collectionVariables.set('admin_refresh_token', j.refresh_token);"
        ],
        "type": "text/javascript"
       }
      }
     ]
    },
    {
     "name": "Refresh token (rotates; saves new tokens)",
     "request": {
      "method": "POST",
      "url": "{{base_url}}/api/v1/auth/refresh",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"refresh_token\": \"{{farmer_refresh_token}}\"\n}"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "var j = pm.response.json();",
         "if (j.access_token) pm.collectionVariables.set('farmer_token', j.access_token);",
         "if (j.refresh_token) pm.collectionVariables.set('farmer_refresh_token', j.refresh_token);"
        ],
        "type": "text/javascript"
       }
      }
     ]
    },
    {
     "name": "Logout (revokes refresh token)",
     "request": {
      "method": "POST",
      "url": "{{base_url}}/api/v1/auth/logout",
      "auth": {
       "bearer": [
        {
         "key": "token",
         "value": "{{farmer_token}}"
        }
       ],
       "type": "bearer"
      },
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"refresh_token\": \"{{farmer_refresh_token}}\"\n}"
      }
     }
    },
    {
     "name": "Forgot password (dev: saves reset_token)",
     "request": {
      "method": "POST",
      "url": "{{base_url}}/api/v1/auth/forgot-password",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"email\": \"farmer@farmmarket.demo\"\n}"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "var j = pm.response.json();",
         "if (j.reset_token) pm.collectionVariables.set('reset_token', j.reset_token);"
        ],
        "type": "text/javascript"
       }
      }
     ]
    },
    {
     "name": "Reset password",
     "request": {
      "method": "POST",
      "url": "{{base_url}}/api/v1/auth/reset-password",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"token\": \"{{reset_token}}\",\n  \"new_password\": \"Demo123!\"\n}"
      }
     }
    },
    {
     "name": "Verify email",
     "request": {
      "method": "POST",
      "url": "{{base_url}}/api/v1/auth/verify-email",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"token\": \"{{verification_token}}\"\n}"
