   "item": [
    {
     "name": "Plan dispatch (Dhaka depot \u2192 Gazipur, Khulna)",
     "request": {
      "auth": {
       "bearer": [
        {
         "key": "token",
         "value": "{{farmer_token}}"
        }
       ],
       "type": "bearer"
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"depot\": {\"lat\": 23.8103, \"lon\": 90.4125},\n  \"stops\": [\n    {\"id\": \"gazipur\", \"lat\": 24.0023, \"lon\": 90.4266, \"load_kg\": 500, \"service_min\": 30},\n    {\"id\": \"savar\", \"lat\": 23.8446, \"lon\": 90.2567, \"load_kg\": 300, \"service_min\": 20}\n  ],\n  \"vehicles\": [\n    {\"id\": \"truck-1\", \"capacity_kg\": 2000, \"refrigerated\": true}\n  ],\n  \"mode\": \"delivery\",\n  \"road_provider\": \"haversine\",\n  \"hub_id\": \"dhaka\"\n}"
      },
      "header": [
       {
