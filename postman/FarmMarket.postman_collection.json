      "body": {
       "mode": "formdata",
       "formdata": [
        {
         "key": "files",
         "type": "file",
         "src": "/path/to/photo.jpg",
         "description": "Attach up to 5 jpeg/png/webp images (<=5 MB each)"
        }
       ]
      }
     }
    }
