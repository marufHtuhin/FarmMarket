# FarmMarket environment example. Copy to .env and adjust:
#   cp .env.example .env
#
# --- Database (MySQL is the documented primary) ---
# MySQL 8 (local server, or `docker compose up` from the repo root):
# compose maps the DB to host port 3307; a local MySQL usually runs on 3306.
DATABASE_URL=mysql+pymysql://root:CHANGE_ME@127.0.0.1:3307/farmmarket_db?charset=utf8mb4
# Quick-demo fallback (no database server needed):
# DATABASE_URL=sqlite:///./farmmarket.db
# TiDB Cloud (Render path — the recommended production database):
# DATABASE_URL=mysql://xxxx.root:CHANGE_ME@gateway01.us-west-2.prod.aws.tidbcloud.com:4000/farmmarket
# TLS is AUTOMATIC for *.tidbcloud.com hosts (verified, certifi CA bundle
# — TiDB's certificates come from Let's Encrypt): no ssl params in the URL
# and no extra variable needed. pool_recycle=300 is set automatically too
# (TiDB Starter closes idle connections after 5 minutes). URL-encode
# special characters in the password, or use a password without them.
# Overrides (rarely needed): DB_SSL=true forces verified TLS for any
# MySQL host; DB_SSL=false forces TLS OFF even for a TiDB host.
# DB_SSL=true
# Advanced: DB_SSL_CA pins a specific CA-bundle path instead of certifi
# (on Render/Debian: /etc/ssl/certs/ca-certificates.crt).
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Generate a unique random key (at least 32 characters) before deployment.
SECRET_KEY=replace-this-with-a-long-random-secret-key
# Short-lived access tokens (60 min, the security.py default): a leaked token
# is only useful for an hour; the rotating 7-day refresh token keeps real
# sessions going. Do NOT raise this casually — 1440 (24h) would silently
# undo the short-lived-token hardening.
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Assistant rate limit (messages per user per minute; default 10)
ASSISTANT_RATE_LIMIT_PER_MIN=10
UPLOAD_DIR=uploads
ENVIRONMENT=development
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5500,http://localhost:5500
# Set TRUST_PROXY=true ONLY when the app runs behind a reverse proxy that
# sets X-Forwarded-For itself (the Caddy in docker-compose.prod.yml, or a
# PaaS edge proxy that appends the real client IP). The auth rate limiter
# keys on the LAST X-Forwarded-For hop then; with TRUST_PROXY unset/false
# it keys on the direct TCP peer, so a forged header cannot defeat it.
# TRUST_PROXY=false

# --- Intelligence features (all optional) ---
# bangladesh (default: Dhaka, Chattogram, Rajshahi, Khulna, Sylhet) or sub_saharan
HUB_PROFILE=bangladesh
# LLM advisor: without a key the advisor returns clearly-labelled template advice
ANTHROPIC_API_KEY=
ADVISOR_MODEL=claude-sonnet-5-5
# Krishi Bondhu assistant (Gemini): Google AI Studio key; without it the assistant uses template fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Faster/cheaper alternative if replies feel slow: gemini-3.5-flash-lite
# answers sooner and costs less, with slightly lower quality. Restart the
# backend after changing this (.env is loaded once at startup).
# GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini call timeout in seconds (default 20, minimum 5). Raise it if the
# assistant keeps falling back to template mode with timeout errors in the
# backend log ("Gemini failed (TimeoutError ...)") — the call itself is
# slow from your network, not the key. Check GET /api/v1/assistant/status
# (admin-only) to see the last Gemini error before raising this blindly.
# GEMINI_TIMEOUT_S=20
# Weather needs NO key any more: it comes from keyless Open-Meteo
# (backend/app/services/datasources/openmeteo.py) for the forecast
# context endpoint, logistics rain derating and advisor context, and for
# the Weather page. OPENWEATHER_API_KEY is LEGACY and IGNORED — if your
# .env still has the line it does nothing and never breaks anything; you
# may delete it. Do not add a key here.
# OPENWEATHER_API_KEY=
# Road routing: self-hosted OSRM, e.g. http://localhost:5000 (otherwise haversine fallback is used)
OSRM_BASE_URL=
# Base URL encoded in batch QR codes (GET /api/v1/twin/batches/{code}/qr -> {base}/verify/{code}).
# Set this to your public frontend URL so a scanned QR opens the verify page on any phone:
# your devtunnel URL locally, your deployed domain on PaaS. If unset, the QR uses the host
# of the incoming request instead — there is no localhost default (a phone's own localhost
# would fail). Leave commented out unless you need to pin a fixed public URL.
# PUBLIC_BASE_URL=https://your-app-domain
# Where trained vision models are stored (default: backend/models)
MODEL_DIR=
# RAG knowledge base for the Krishi Bondhu assistant (default: docs/knowledge
# at the repo root). Point it elsewhere only to test with a different corpus.
KNOWLEDGE_DIR=

# --- Production (docker-compose.prod.yml + Caddy; see DEPLOY.md) ------------
# For the production Docker stack, copy this file to the REPO ROOT as .env
# (not backend/.env): compose reads the root .env for ${} substitution, and
# the api service receives its variables from compose, not from a file.
# The variables below are REQUIRED in production; compose fails fast if any
# is missing. Never reuse the demo values above.
#
# ENVIRONMENT=production requirements:
#   - DATABASE_URL must point at MySQL; SQLite is refused at startup in
#     production. (In the prod compose stack DATABASE_URL is built from
#     MYSQL_ROOT_PASSWORD automatically — you do not set it by hand.)
#   - SECRET_KEY must be >= 32 random characters (never a demo value):
#       python -c "import secrets; print(secrets.token_urlsafe(48))"
#   - FRONTEND_ORIGINS must be exactly your public origin:
#       FRONTEND_ORIGINS=https://farmmarket.example.com
#   - DOMAIN is the public domain Caddy serves and obtains TLS for:
#       DOMAIN=farmmarket.example.com
#   - MYSQL_ROOT_PASSWORD is required by the prod compose stack and has no
#     default. Use URL-safe characters (letters, digits, - _ .) or
#     percent-encode special characters, because the password is embedded
#     in DATABASE_URL. Example (generate your own, do not use this one):
#       MYSQL_ROOT_PASSWORD=change-me-to-a-long-random-password
#
# --- Scheduler (in-app auto-update) ----------------------------------------
# Daily price-freshness check, run inside the API process by APScheduler.
# OFF by default; enable in production only. FAOSTAT is annual-only and is
# NEVER scheduled — it stays a manual, clearly-labelled annual reference
# behind the admin sync endpoint (see docs/knowledge/faostat-notes.md).
# SCHEDULER_ENABLED=true
# SCHEDULER_FRESHNESS_HOUR=4   # hour of day (UTC) for the freshness check
# SCHEDULER_FRESHNESS_DAYS=60  # a price series is "stale" after this many days

# --- SMTP (email: password reset + registration verification) ------------
# The mailer (backend/app/services/mailer.py, stdlib smtplib) sends the
# password-reset link and the registration verification link. It is
# active only when SMTP_HOST, SMTP_USER and SMTP_PASSWORD are all set;
# otherwise registration and password reset still work, but NO emails
# are sent. In non-production the register/forgot responses include the
# plaintext token (verification_token / reset_token) so the flows can be
# tested without email; in production the tokens are NEVER in the
# response — the links are only delivered by email, so SMTP must be
# configured before real users depend on reset/verification.
# Email link base: PUBLIC_BASE_URL -> the request's Origin header ->
# the request's Referer origin -> first FRONTEND_ORIGINS entry -> the
# request's own base URL -> http://localhost:5173. The Origin/Referer
# come from the frontend page the request was sent from, so local links
# point at :5173 automatically and tunnel/production links at the real
# frontend host. Set PUBLIC_BASE_URL to the public frontend URL to pin
# it (locally that is http://127.0.0.1:5173 — NOT :8000, which is the
# backend). The :5500 entries above are stale Live Server leftovers,
# kept only as CORS origins.
# Gmail example (any SMTP server works):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=<app password — see below, NEVER your real Gmail password>
# SMTP_FROM=you@gmail.com   # optional: same as SMTP_USER, or leave unset
# Gmail app password (needs 2-Step Verification ON — a normal Gmail
# password does NOT work for SMTP):
#   Google Account -> Security -> 2-Step Verification ON -> App passwords
#   -> generate one for "Mail" -> paste the 16-character code into
#   SMTP_PASSWORD (spaces optional). If the account has no app-password
#   option, 2-Step Verification is not fully on yet.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=true
